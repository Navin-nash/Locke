# Names only. Copy to .env.local and fill in. Never commit values. See AGENTS.md section 6.
OPENROUTER_API_KEY=
NEATLOGS_API_KEY=
CRUSTDATA_API_KEY=
DATABASE_URL=
APP_URL=
# baseline | improved
LOCKE_VARIANT=
# Optional model overrides (defaults live in lib/models.ts)
LOCKE_MODEL_PLANNER=
LOCKE_MODEL_WORKER=
LOCKE_MODEL_VERIFIER=
# memory | postgres
LOCKE_CHECKPOINTER=
# Non-production fault injection, e.g. crustdata:429,careers:blocked
LOCKE_FAULTS=
